Panels:
  - Class: rviz_common/Displays
    Help Height: 78
    Name: Displays
    Property Grid State:
      expanded:
        - /Grid1
        - /RobotModel1
        - /TF1
        - /TF1/Frames
        - /LaserScan1
        - /CameraImage1
        - /Odometry1
        - /Map1
      split: 150
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.15
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 160
      Enabled: true
      Line Width: 0.01
      Name: Grid
      Normal Cell Count: 0
      Plane: XY
      Reference Frame: base_footprint
    - Class: rviz_default_plugins/RobotModel
      Description Source: Topic
      Description Topic: /robot_description
      Enabled: true
      Name: RobotModel
      Visual Enabled: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF
      Marker Scale: 0.3
      Show Arrows: true
      Show Axes: true
      Show Names: false
      Frames:
        All Enabled: false
        odom:
          Enabled: false
        base_footprint:
          Enabled: false
        base_link:
          Enabled: false
        lidar_link:
          Enabled: true
        camera_link:
          Enabled: false
        camera_link_optical:
          Enabled: false
        imu_link:
          Enabled: false
        left_wheel:
          Enabled: true
        right_wheel:
          Enabled: true
    - Class: rviz_default_plugins/LaserScan
      Topic: /scan
      Color Transformer: AxisColor
      Style: Spheres
      Size (m): 0.03
      Decay Time: 0
      Enabled: true
      Name: LaserScan
      Selectable: true
    - Class: rviz_default_plugins/Image
      Topic: /camera/image_raw
      Enabled: true
      Name: CameraImage
    - Class: rviz_default_plugins/Odometry
      Topic: /odom
      Enabled: true
      Name: Odometry
      Keep: 1
      Color: 0; 255; 0
    - Class: rviz_default_plugins/Marker
      Topic: /safety_zone_marker
      Enabled: true
      Name: SafetyZone
    - Class: rviz_default_plugins/Map
      Topic: /map
      Update Topic: /map_updates
      Enabled: true
      Name: Map
      Alpha: 0.7
    - Class: rviz_default_plugins/Map
      Topic: /global_costmap/costmap
      Update Topic: /global_costmap/costmap_updates
      Enabled: true
      Name: GlobalCostmap
      Alpha: 0.4
      Color Scheme: costmap
    - Class: rviz_default_plugins/Map
      Topic: /local_costmap/costmap
      Update Topic: /local_costmap/costmap_updates
      Enabled: true
      Name: LocalCostmap
      Alpha: 0.5
      Color Scheme: costmap
    - Class: rviz_default_plugins/Path
      Topic: /plan
      Enabled: true
      Name: GlobalPath
      Color: 255; 0; 0
    - Class: rviz_default_plugins/Path
      Topic: /local_plan
      Enabled: true
      Name: LocalPlan
      Color: 0; 255; 0
  Global Options:
    Background Color: 30; 30; 30
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/SetInitialPose
      Topic: /initialpose
    - Class: nav2_rviz_plugins/GoalTool
      Topic: /goal_pose
    - Class: rviz_default_plugins/PublishPoint
      Topic: /clicked_point
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Target Frame: base_footprint
      Scale: 100
      Angle: 0
      Focal Point:
        X: 0
        Y: 0
        Z: 0
    Saved: ~
